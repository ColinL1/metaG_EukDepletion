process {

    withName: 'NFCORE_MAG:MAG:PRODIGAL' {
        time = 2.d
    }

    withName: 'NFCORE_MAG:MAG:BINNING_PREPARATION:BOWTIE2_ASSEMBLY_ALIGN' {
        time = 4.d
    }

    withName: 'NFCORE_MAG:MAG:SHORTREAD_PREPROCESSING:BOWTIE2_PHIX_REMOVAL_ALIGN' {
        time = 2.d
    }

    withName: 'NFCORE_MAG:MAG:VIRUS_IDENTIFICATION:GENOMAD_ENDTOEND' {
        time = 14.d
    }

    withName: 'NFCORE_MAG:MAG:BINNING:FASTA_BINNING_CONCOCT:CONCOCT_CONCOCTCOVERAGETABLE' {
        time = 4.d
    }

    withName: 'NFCORE_MAG:MAG:BINNING:FASTA_BINNING_CONCOCT:CONCOCT_CONCOCT' {
        time = 60.d
    }

    withName: 'NFCORE_MAG:MAG:BINNING_REFINEMENT:DASTOOL_DASTOOL' {
        memory = '800 GB'
        containerOptions = "--env R_MAX_VSIZE=800Gb --env OMP_NUM_THREADS=100"
    }

    withName: 'NFCORE_MAG:MAG:METAEUK_EASYPREDICT' {
        memory = '800 GB'
        cpus = 250
    }

    withName: 'NFCORE_MAG:MAG:METASPADES' {
        memory = '200 GB'
    }

    withName: 'NFCORE_MAG:MAG:PROKKA' {
        time = 3.d
    }

}

