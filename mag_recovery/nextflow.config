// nextflow.config for nf-core/mag (auto-loaded when launched from mag_recovery/)
// Adjust the limits below to your machine / cluster.
// Setting used in local testing, but not recommended HPC deployment. Deafult to preconfigured cluster profiles for your HPC system. https://nf-co.re/configs/

includeConfig 'process_resources.config'

executor {
    cpus   = 300
    memory = '500 GB'
}

process {
    resourceLimits = [
        cpus: 300,
        memory: 1000.GB
    ]
}

apptainer {
    runOptions = '--no-mount resolv.conf'
}

singularity {
    runOptions = '--no-mount resolv.conf'
}
