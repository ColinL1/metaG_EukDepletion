// nextflow.config
nextflow.enable.dsl=2
notification.enabled = true

includeConfig 'labels.config'

executor {
  cpus = 250
}

// Global default params
params {

  // Input/Output
  input = "${projectDir}/input"
  outdir = "${projectDir}/results"
  input_fq = "${params.input}/*_{1,2}.fq.gz"

  // trim adapter
  adapters = "${projectDir}/assets/adapters/Truseq_V.3_edited.fa"
  illuminaclip = "2:30:10:8:TRUE"
  headcrop = 5
  leading = 3
  trailing = 3
  slidingwindow = "4:20"
  minlen = 50

  // bowtie2 references index
  ref_bt2_aip = '/path/to/references/ref_genomes_bowtie2/all_aiptasiidae*'
  ref_bt2_scl = '/path/to/references/ref_genomes_bowtie2/all_scleractina*'
  ref_bt2_sym = '/path/to/references/ref_genomes_bowtie2/all_symbiodiniaceae*'

  //minimap2 references index
  ref_mmi_aip = '/path/to/references/ref_genomes_minimap2_contigs/all_aiptasiidae.mmi'
  ref_mmi_scl = '/path/to/references/ref_genomes_minimap2_contigs/all_scleractinia.mmi'
  ref_mmi_sym = '/path/to/references/ref_genomes_minimap2_contigs/all_symbiodiniaceae.mmi'

  //megahit setting
  k_min = 27
  k_max = 127

  //kaiju nodes, names and db (NR: kaiju-makedb -s nr)
  nodes = '/path/to/kaiju/nodes.dmp'
  names = '/path/to/kaiju/names.dmp'
  kaiju_db = '/path/to/kaiju/kaiju_db_nr.fmi'
  // ranks written by kaiju-addTaxonNames; the first one is used to recognise Bacteria
  kaiju_ranks = 'superkingdom,phylum,class,order,family,genus,species'

  // CAT db (NR)
  cat_db = "/path/to/databases/CAT/CAT_nr"

  // CAT read-mapping quantification of bacterial contigs
  cat_quant_mode = 'both'   // persample | pooled | both
  derep = true              // dereplicate the pooled catalogue (mmseqs easy-linclust)
  derep_id = 0.95
  derep_cov = 0.90
  min_read_id = 0.95        // CoverM read identity filter
  min_read_aln = 0.75       // CoverM aligned-fraction filter
  
}

profiles {
  conda {
    conda.enabled = true
    conda.useMamba = true
    }
  apptainer {
    apptainer.enabled = true
    apptainer.autoMounts = true
    // references/databases are passed as path strings: bind any that live outside $HOME
    // apptainer.runOptions = '-B /path/to/databases'
    }
}

manifest {
  name        = 'ColinL1/metaG_EukDepletion'
  description = 'Nextflow pipeline for kingdom-level taxonomic classification to assess eukaryotic DNA depletion in hexacorallia metagenomics'
  author      = 'Luigi Colin'
  version     = '1.0.0'
  homePage    = 'https://github.com/ColinL1/metaG_EukDepletion'
  mainScript  = 'main.nf'
  nextflowVersion = '>=23.0'
}